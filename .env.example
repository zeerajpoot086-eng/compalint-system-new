# GEMINI_API_KEY: Optional/runtime Gemini API key for AI Smart Analysis
# If not provided, FixMate uses its built-in rule-based analysis engine seamlessly.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret used to sign and verify JSON Web Tokens for auth
JWT_SECRET="fixmate_jwt_secret_key_prod_2026_secure"

# MONGO_URI: Optional MongoDB Atlas connection string.
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/fixmate?retryWrites=true&w=majority
MONGO_URI=""

# PORT: Server port (defaults to 3000)
PORT=3000

